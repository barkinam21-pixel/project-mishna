{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "speechResourceName": {
      "type": "string",
      "minLength": 2,
      "metadata": {
        "description": "EXISTING Speech resource name in the selected EXISTING resource group. No Speech resource is created or changed."
      },
      "defaultValue": "bar-universal-speech-2026"
    },
    "identityName": {
      "type": "string",
      "defaultValue": "mishnah-speech-github",
      "minLength": 3,
      "maxLength": 128
    }
  },
  "variables": {
    "identityId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]",
    "speechId": "[resourceId('Microsoft.CognitiveServices/accounts', parameters('speechResourceName'))]",
    "readerRole": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'acdd72a7-3385-48ef-bd42-f606fba81ae7')]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[parameters('identityName')]",
      "location": "[resourceGroup().location]"
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
      "apiVersion": "2023-01-31",
      "name": "[concat(parameters('identityName'), '/github-azure-speech')]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
      ],
      "properties": {
        "issuer": "https://token.actions.githubusercontent.com",
        "subject": "repo:barkinam21-pixel@312509860/project-mishna@1342201292:environment:azure-speech",
        "audiences": [
          "api://AzureADTokenExchange"
        ]
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(variables('speechId'), variables('identityId'), 'Reader')]",
      "scope": "[variables('speechId')]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('readerRole')]",
        "principalId": "[reference(variables('identityId'), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "AZURE_CONNECTION": {
      "type": "object",
      "value": {
        "clientId": "[reference(variables('identityId'), '2023-01-31').clientId]",
        "tenantId": "[subscription().tenantId]",
        "subscriptionId": "[subscription().subscriptionId]",
        "resourceId": "[variables('speechId')]"
      }
    }
  }
}
